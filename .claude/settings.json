{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy*)",
      "Bash(uv run prek *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv build*)",
      "Bash(devcontainer up --workspace-folder .*)",
      "Bash(devcontainer exec --workspace-folder . uv run pytest*)",
      "Bash(devcontainer exec --workspace-folder . uv run ruff *)",
      "Bash(devcontainer exec --workspace-folder . uv run mypy*)",
      "Bash(devcontainer exec --workspace-folder . uv run prek *)",
      "Bash(devcontainer exec --workspace-folder . uv sync*)",
      "Bash(devcontainer exec --workspace-folder . uv lock*)",
      "Bash(devcontainer exec --workspace-folder . uv build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git commit *-n *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ]
  }
}
